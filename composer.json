{
    "name": "jacksleight/laravel-raster",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "JackSleight\\LaravelRaster\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JackSleight\\LaravelRaster\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "spatie/browsershot": "^5.0.5"
    },
    "require-dev": {
        "pestphp/pest": "^3.5",
        "phpstan/phpstan": "^1.12",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
